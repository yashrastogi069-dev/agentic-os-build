# Agentic OS / Jarvis — copy to .env.local and fill in.
# Never commit .env.local (it is gitignored). Values below are placeholders.

# ---- AI brain: provider failsafe chain (lib/providers.ts) ----
# Order: Gemini -> Groq -> OpenRouter (free) -> NVIDIA NIM -> Ollama (local).
# The app works with any subset configured; missing keys are skipped.
GOOGLE_GENERATIVE_AI_API_KEY=   # Gemini (https://aistudio.google.com/apikey)
GROQ_API_KEY=                   # Groq (https://console.groq.com)
OPENROUTER_API_KEY=             # OpenRouter free models (https://openrouter.ai/keys)
NVIDIA_API_KEY=                 # NVIDIA NIM, nvapi- key (https://build.nvidia.com)

# Comma-separated provider ids to force-disable (failover testing / manual pin).
# e.g. FORCE_DISABLE_PROVIDERS=gemini  -> chat starts at Groq.
# FORCE_DISABLE_PROVIDERS=

# ---- Research chain (agent webSearch / fetchPage tools, lib/research.ts) ----
# webSearch: Tavily -> Serper (fallback). fetchPage: Firecrawl.
TAVILY_API_KEY=                 # https://tavily.com
SERPER_API_KEY=                 # https://serper.dev
FIRECRAWL_API_KEY=              # https://firecrawl.dev

# ---- GitHub connector — classic PAT with repo + notifications scopes ----
GITHUB_TOKEN=

# ---- Ollama (local; embeddings + local chat floor). Defaults shown. ----
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2:3b

# ---- Voice stack overrides (defaults: ./bin and ./models via setup-voice) ----
# WHISPER_BIN=
# WHISPER_MODEL=
# PIPER_BIN=
# PIPER_VOICE=
