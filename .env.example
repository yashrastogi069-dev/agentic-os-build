# Agentic OS — copy to .env.local and fill in

# Chat + voice brain (free tier: https://console.groq.com)
GROQ_API_KEY=

# Provider failsafe chain (Phase 1: Gemini -> OpenRouter -> NVIDIA -> Ollama)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Research failsafe chain (cache -> Tavily -> Serper -> Exa -> Jina)
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# GitHub connector — classic PAT with repo + notifications scopes
GITHUB_TOKEN=

# Ollama (defaults shown)
# OLLAMA_URL=http://127.0.0.1:11434

# Voice stack overrides (defaults: ./bin and ./models via scripts/setup-voice.sh)
# WHISPER_BIN=
# WHISPER_MODEL=
# PIPER_BIN=
# PIPER_VOICE=
